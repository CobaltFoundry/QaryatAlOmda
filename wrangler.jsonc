{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omda",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omda-db"
    }
  ]
}
